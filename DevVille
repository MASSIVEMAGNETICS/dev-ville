        </div>

        <!-- Main Content Tabs -->
        <div class="flex border-b border-slate-800 mb-6">
            <div onclick="switchTab(this, 'dashboard-tab')" class="nav-tab active cursor-pointer px-6 py-3 text-sm font-semibold flex items-center gap-x-2 border-b-2 border-indigo-500 text-white">
