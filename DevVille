<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DevVille • MASSIVEMAGNETICS</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&amp;family=Space+Grotesk:wght@500;600&amp;display=swap');
        
        :root {
            --primary: #6366f1;
        }
        
        body {
            font-family: 'Inter', system_ui, sans-serif;
        }
        
        .font-display {
            font-family: 'Space Grotesk', 'Inter', sans-serif;
            font-weight: 600;
        }

        .glass {
            background: rgba(255,255,255, 0.06);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255,255,255, 0.1);
        }

        .section-header {
            font-size: 0.75rem;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            font-weight: 600;
            color: #64748b;
        }

        .agent-card {
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .agent-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
        }

        .status-dot {
            animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }

        .nav-tab {
            position: relative;
            transition: all 0.2s ease;
        }
        
        .nav-tab.active::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(to right, #6366f1, #a855f7);
        }

        .kanban-column {
            background: rgba(15, 23, 42, 0.6);
            min-height: 420px;
        }

        .log-entry {
            animation: fadeInUp 0.3s ease forwards;
        }

        .professional-shadow {
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.3),
                        0 4px 6px -4px rgb(0 0 0 / 0.3);
        }

        .metric-value {
            font-variant-numeric: tabular-nums;
        }

        .devville-gradient {
            background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .memory-node {
            transition: all 0.2s ease;
        }

        .simulation-log {
            scrollbar-width: thin;
            scrollbar-color: #475569 #1e2937;
        }

        .modern-card {
            transition: transform 0.2s cubic-bezier(0.4, 0.0, 0.2, 1), 
                        box-shadow 0.2s cubic-bezier(0.4, 0.0, 0.2, 1);
        }
        
        .modern-card:hover {
            transform: translateY(-1px);
            box-shadow: 0 20px 25px -5px rgb(15 23 42 / 0.1), 0 8px 10px -6px rgb(15 23 42 / 0.1);
        }

        .agent-avatar {
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            border-radius: 9999px;
            background: linear-gradient(145deg, #334155, #1e2937);
            border: 2px solid #475569;
        }

        .phase-indicator {
            height: 3px;
            background: linear-gradient(to right, #6366f1, #a855f7);
            transition: width 0.4s ease;
        }

        .enterprise-text {
            font-feature-settings: "ss02";
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-200">
    <!-- Top Navigation -->
