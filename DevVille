    <!-- New Project Modal -->
    <div id="new-project-modal" onclick="if (event.target.id === 'new-project-modal') hideNewProjectModal()" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-[100] flex items-center justify-center">
        <div onclick="event.stopImmediatePropagation()" class="glass border border-slate-700 rounded-3xl w-full max-w-lg mx-4 overflow-hidden">
            <div class="p-8">
                <div class="flex justify-between mb-6">
