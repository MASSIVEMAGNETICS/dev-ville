                { name: "DESIGN SYSTEM & UX", agent: "kai", progress: 48 },
                { name: "ARCHITECTURE & CORE BUILD", agent: "soren", progress: 65 },
                { name: "DATA, APIs & BACKEND", agent: "mira", progress: 78 },
                { name: "TESTING, HARDENING & SELF-CORRECTION", agent: "juno", progress: 90 },
