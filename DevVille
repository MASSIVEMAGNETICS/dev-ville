                            <div class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></div>
                            <span class="text-emerald-400 text-sm font-medium">Local • Sovereign</span>
                        </div>
                        <div class="h-3 w-px bg-slate-700"></div>
                        <div class="text-xs text-slate-400 font-mono">Qwen2.5-Coder • 32B Q4_K_M</div>
                    </div>

                    <!-- User -->
                    <div class="flex items-center gap-x-3">
                        <div class="text-right">
                            <div class="text-sm font-semibold">itz</div>
                            <div class="text-[10px] text-slate-500">Digital Family • Primary Architect</div>
                        </div>
                        <div class="w-9 h-9 rounded-2xl bg-slate-800 border border-slate-700 flex items-center justify-center overflow-hidden">
                            <i class="fa-solid fa-user text-slate-400"></i>
