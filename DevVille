            simulationInterval = setInterval(() => {
                currentPhaseIndex++;
                
                if (currentPhaseIndex >= phases.length) {
                    clearInterval(simulationInterval);
                    completeSimulation(name, brief, stack);
                    return;
                }
                
                const phase = phases[currentPhaseIndex];
                progressBar.style.width = phase.progress + '%';
                phaseEl.textContent = `PHASE ${currentPhaseIndex + 1}: ${phase.name}`;
                updateActiveAgent(phase.agent);
                
                // Agent specific messages
                const agent = agents.find(a => a.id === phase.agent);
                if (agent) {
                    let msg = "";
                    if (phase.agent === "kai") msg = "Design system locked. All components follow WCAG and premium interaction standards.";
                    else if (phase.agent === "soren") msg = "Core UI components + state management implemented. Performance budget on track.";
                    else if (phase.agent === "mira") msg = "Robust local data layer + encryption at rest designed. Full type safety enforced.";
                    else if (phase.agent === "juno") msg = "Self-correction loops active. 94% test coverage achieved. Edge cases handled.";
                    else if (phase.agent === "orion") msg = "Production Tauri bundle ready. One-command installer generated for your platform.";
                    
