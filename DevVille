                            </div>
                            <div>
                                <label class="block text-sm font-medium text-slate-300 mb-2">Timeline Priority</label>
                                <select id="timeline" class="w-full bg-slate-900 border border-slate-700 rounded-2xl px-4 py-3 text-sm">
                                    <option value="balanced">Balanced Quality</option>
