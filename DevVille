                    <span class="font-mono text-emerald-400">Hybrid Episodic + Graph</span>
                </div>
            `;
            
            function updateActiveAgent(agentId) {
                const agent = agents.find(a => a.id === agentId);
                if (!agent || !activeAgentCard) return;
                
                activeAgentCard.innerHTML = `
                    <div class="flex gap-x-3">
                        <div class="agent-avatar text-xl flex-shrink-0" style="background: linear-gradient(145deg, ${agent.color}22, #1e2937)">
