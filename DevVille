                                <span class="text-xs px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 font-mono tracking-[1.5px]">v0.8.4</span>
                            </div>
                            <div class="text-[10px] text-slate-500 -mt-1 font-medium">MASSIVEMAGNETICS • SOVEREIGN STUDIO</div>
