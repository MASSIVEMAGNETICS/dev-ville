            <div onclick="switchTab(this, 'forge-tab')" class="nav-tab cursor-pointer px-6 py-3 text-sm font-semibold flex items-center gap-x-2 text-slate-400 hover:text-slate-200">
                <i class="fa-solid fa-hammer w-4"></i>
                <span>Project Forge</span>
            </div>
            <div onclick="switchTab(this, 'memory-tab')" class="nav-tab cursor-pointer px-6 py-3 text-sm font-semibold flex items-center gap-x-2 text-slate-400 hover:text-slate-200">
                <i class="fa-solid fa-brain w-4"></i>
                <span>Memory Vault</span>
