            function addSimLog(agentName, message, highlight = false) {
                logCount++;
                const entry = document.createElement('div');
                entry.className = `px-4 py-[7px] text-xs flex gap-x-3 ${highlight ? 'bg-indigo-500/5' : ''}`;
                entry.innerHTML = `
                    <div class="font-mono text-[10px] text-slate-500 w-9 flex-shrink-0 pt-px">${String(logCount).padStart(2, '0')}</div>
                    <div class="flex-1">
                        <span class="font-semibold text-slate-200">${agentName}:</span> 
                        <span class="text-slate-300">${message}</span>
                    </div>
                `;
                logContainer.appendChild(entry);
                logContainer.scrollTop = logContainer.scrollHeight;
            }
            
            // Initial logs
            setTimeout(() => {
                addSimLog("Elias Voss", "Project accepted. Running initial pre-simulation on scope and alignment with your goals.", true);
